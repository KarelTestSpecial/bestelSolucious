rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Production Security Rules: Strict user-based isolation
    match /users/{userId} {
      // Allow the user to manage their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Explicitly allow access to known sub-collections
      match /orders/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /deliveries/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /products/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /consumption/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
